{
  "name": "app-vsph-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-next-route-types.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node scripts/clean-next-route-types.mjs && next typegen && tsc --noEmit",
    "test:migration": "node --test tests/migration-source.test.mjs",
    "check": "npm run test:migration && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
